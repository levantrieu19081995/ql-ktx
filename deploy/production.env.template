# Sao chép file này thành:
# /home/admin_ktx/domains/ktx.ctu.edu.vn/frontend/shared/production.env
# Sau đó chmod 600 và điền giá trị thật trực tiếp trên server.

NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NEXTAUTH_URL=https://ktx.ctu.edu.vn

# Địa chỉ ứng dụng lắng nghe. Mặc định 127.0.0.1 (chỉ nghe nội bộ, đi qua reverse proxy).
# Khi chưa có tên miền và truy cập thẳng bằng IP trong LAN, bỏ dấu # ở dòng dưới và đổi NEXTAUTH_URL
# thành http://<IP-server>:3000 (ví dụ http://172.18.141.250:3000):
# HOSTNAME_LISTEN=0.0.0.0
NEXTAUTH_SECRET=
API_BASE_URL=

# Chỉ cần khi face-detect dùng host hoặc service token riêng.
FACE_DETECT_BASE_URL=
FACE_DETECT_SERVICE_TOKEN=

# Chỉ cần khi ảnh lịch sử được lưu ở host riêng.
IMAGE_BASE_URL=
IMAGE_SERVICE_TOKEN=

# Service camera / nhan dien khuon mat (proxy /api/camera-service)
CAMERA_BASE_URL=
CAMERA_ADMIN_TOKEN=
